# Application Configuration
NODE_ENV=development
APP_MODE=ALL
PORT=3000

# AWS Credentials & Region
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
TERRAFORM_AWS_ACCESS_KEY_ID=your_terraform_access_key_id
TERRAFORM_AWS_SECRET_ACCESS_KEY=your_terraform_secret_access_key

# Amazon Cognito
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_REGION=us-east-1

# Amazon Bedrock Models & Dimensions
BEDROCK_MODEL_CHAT=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MODEL_FAST=anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_MODEL_EMBEDDING=amazon.titan-embed-text-v2:0
BEDROCK_MODEL_MULTIMODAL=amazon.titan-embed-image-v1
EMBEDDING_DIMENSIONS=1024
MAX_CHUNK_TOKENS=1024

# Bedrock Guardrails (Optional)
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# Bedrock Data Automation (BDA) Staging Bucket (Optional for cloud BDA bridge from local Floci)
AWS_BDA_STAGING_BUCKET=

# Local Infrastructure (Docker Floci & Postgres)
FLOCI_ENDPOINT=http://localhost:4566
S3_BUCKET_NAME=notebooklm-documents
SQS_INGESTION_QUEUE_URL=http://localhost:4566/000000000000/notebooklm-ingestion-queue

# Database (PostgreSQL 18+ with pgvector)
DB_WRITE_HOST=localhost
DB_WRITE_PORT=5432
DB_READ_HOSTS=localhost
DB_NAME=notebooklm
DB_USER=app_user
DB_PASSWORD=app_user_secret
